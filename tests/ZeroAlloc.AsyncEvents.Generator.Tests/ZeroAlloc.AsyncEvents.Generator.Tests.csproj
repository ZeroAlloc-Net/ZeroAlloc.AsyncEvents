<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0;net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ZeroAlloc.TestHelpers" Version="1.10.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Basic.Reference.Assemblies.Net90" Version="1.8.15" Condition="'$(TargetFramework)' != 'net11.0'" />
    <PackageReference Include="Basic.Reference.Assemblies.Net110" Version="1.8.15" Condition="'$(TargetFramework)' == 'net11.0'" />
    <ProjectReference Include="..\..\src\ZeroAlloc.AsyncEvents.Generator\ZeroAlloc.AsyncEvents.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="true" />
    <ProjectReference Include="..\..\src\ZeroAlloc.AsyncEvents\ZeroAlloc.AsyncEvents.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Snapshots are data, not code. Verify's targets excluded them from compilation; without
       that every .verified.cs is compiled and collides (CS0101). -->
  <ItemGroup>
    <Compile Remove="**/*.verified.*" />
    <Compile Remove="**/*.received.*" />
  </ItemGroup>

</Project>
