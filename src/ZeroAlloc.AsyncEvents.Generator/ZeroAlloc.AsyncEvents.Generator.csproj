<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!--
      The generator is bundled into ZeroAlloc.AsyncEvents's NuGet package via the
      <None ... PackagePath="analyzers/dotnet/cs"> item in the main library's csproj.
      Publishing a separate ZeroAlloc.AsyncEvents.Generator package would just produce
      a broken stand-alone nupkg (DLL under lib/, not analyzers/), so suppress packing.
    -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Release tracking for the ZAAE diagnostics: RS2000-RS2008 read these, so a changed
         severity or category, or a removed ID, on a shipped rule fails the build. -->
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ZeroAlloc.AsyncEvents.Generator.Tests" />
  </ItemGroup>
</Project>
